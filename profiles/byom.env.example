# Profile: bring your own model / key. Quality tier: compatible-unvalidated.
#
# Any OpenAI-compatible chat endpoint for extraction and any OpenAI-compatible embedding endpoint,
# configured independently. memquira works with them, but their memory quality is not measured by this
# project: measure retrieval and answer quality on your own data.
#
# Copy to profiles/byom.env (git-ignored) and replace every REPLACE_ value (keys from your secret store).
# The vector-space identity is fail-closed: once a collection holds vectors from one embedding model,
# memquira refuses to start with another (use new collection names, or memquira-maintenance to erase).

MEMQUIRA_REQUIRE_QUALITY_TIER=compatible-unvalidated
# One chat call per start that must return valid JSON (costs one call on a paid endpoint).
MEMQUIRA_LLM_STARTUP_PROBE=true

MEMQUIRA_ENV=production
MEMQUIRA_HOST=0.0.0.0
MEMQUIRA_PORT=8080
MEMQUIRA_LOG_FORMAT=json
MEMQUIRA_LOG_LEVEL=info
MEMQUIRA_SECURITY_HEADERS_ENABLED=true
MEMQUIRA_CORS_ENABLED=false
MEMQUIRA_STARTUP_DEPENDENCY_TIMEOUT_SECONDS=120
MEMQUIRA_AUTH_ENABLED=true
MEMQUIRA_AUTH_MODE=dev
MEMQUIRA_DEV_API_KEY=REPLACE_with_a_long_random_api_key

# --- Storage (embedded SQLite shown; PostgreSQL as in profiles/reference.env.example) ---------------
MEMQUIRA_STORAGE_MODE=embedded
MEMQUIRA_FACT_BACKEND=sqlite
MEMQUIRA_EVENT_BACKEND=sqlite
MEMQUIRA_DATABASE_URL=sqlite:///app/data/memcore.db?mode=rwc
MEMQUIRA_DATABASE_MIGRATION_MODE=auto
MEMQUIRA_VECTOR_BACKEND=qdrant
MEMQUIRA_QDRANT_URL=http://qdrant:6334
MEMQUIRA_QDRANT_COLLECTION=memcore_byom_facts
MEMQUIRA_QDRANT_EPISODE_COLLECTION=memcore_byom_episodes

# --- Extraction / chat endpoint -------------------------------------------------------------------
MEMQUIRA_LLM_PROVIDER=openai
MEMQUIRA_LLM_MODEL=REPLACE_chat_model_id
MEMQUIRA_LLM_BASE_URL=https://llm.example.com/v1
MEMQUIRA_LLM_API_KEY=REPLACE_llm_api_key
# json_object (default; response_format json_object), json_schema (structured outputs) or
# instruction (no response_format; the prompt demands JSON) for servers that reject response_format.
MEMQUIRA_LLM_JSON_MODE=json_object

# --- Embedding endpoint (identity: model, revision, dimensions, prefixes, normalisation) -------------
MEMQUIRA_EMBEDDING_PROVIDER=openai
MEMQUIRA_EMBEDDING_MODEL=REPLACE_embedding_model_id
MEMQUIRA_EMBEDDING_BASE_URL=https://embeddings.example.com/v1
MEMQUIRA_EMBEDDING_API_KEY=REPLACE_embedding_api_key
MEMQUIRA_EMBEDDING_DIMENSIONS=1024
MEMQUIRA_EMBEDDING_SEND_DIMENSIONS=true
MEMQUIRA_EMBEDDING_NORMALIZE=false
# MEMQUIRA_EMBEDDING_MODEL_REVISION=
# MEMQUIRA_EMBEDDING_QUERY_PREFIX=
# MEMQUIRA_EMBEDDING_DOCUMENT_PREFIX=
# Dedup: exact text only for an uncalibrated model (D-L3). Set MEMQUIRA_EMBEDDING_DEDUP_THRESHOLD only
# after calibrating it for this model.
MEMQUIRA_PROVIDER_PROBE=true
MEMQUIRA_ALLOW_MOCK=false
MEMQUIRA_REAL_PROVIDER_CALLS_ENABLED=true
MEMQUIRA_PROVIDER_TEST_MODE=production
MEMQUIRA_PROVIDER_MAX_CALLS_PER_RUN=10000000
MEMQUIRA_PROVIDER_TIMEOUT_SECONDS=90

# --- Default retrieval settings, every optional feature OFF -----------------------------------------
MEMQUIRA_STRUCTURED_EXTRACTION_ENABLED=true
MEMQUIRA_STRUCTURED_EXTRACTION_POLICY=retentive
MEMQUIRA_EPISODES_ENABLED=true
MEMQUIRA_SEARCH_MAX_LIMIT=100
MEMQUIRA_QUERY_EMBEDDING_CACHE_CAPACITY=10000
MEMQUIRA_CONSOLIDATION_MODE=legacy
MEMQUIRA_ENTITIES_ENABLED=false
MEMQUIRA_QUERY_ANALYSIS_ENABLED=false
MEMQUIRA_TEMPORAL_RANKING_ENABLED=false
MEMQUIRA_MULTI_QUERY=none
MEMQUIRA_RERANK_PROVIDER=none
MEMQUIRA_QUERY_DECOMPOSITION=none
MEMQUIRA_EXPERIMENTAL_CANDIDATES_ENABLED=false
MEMQUIRA_CONTEXT_CACHE_ENABLED=false
MEMQUIRA_CONTEXT_CACHE_BACKEND=disabled

# --- Load protection and metrics -------------------------------------------------------------------
MEMQUIRA_ADMISSION_CONTROL=on
MEMQUIRA_PROVIDER_CHAT_MAX_CONCURRENCY=8
MEMQUIRA_PROVIDER_EMBEDDING_MAX_CONCURRENCY=16
MEMQUIRA_RATE_LIMIT_ENABLED=true
MEMQUIRA_RATE_LIMIT_REQUESTS_PER_MINUTE=600
MEMQUIRA_METRICS_ENABLED=true
MEMQUIRA_BACKGROUND_JOBS_ENABLED=false
