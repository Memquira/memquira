# Profile: bring your own model / key. Quality tier: compatible-unvalidated.
#
# Any OpenAI-compatible chat endpoint for extraction and any OpenAI-compatible embedding endpoint,
# configured independently. memcore works with them, but their memory quality is not measured by this
# project: measure retrieval and answer quality on your own data.
#
# Copy to profiles/byom.env (git-ignored) and replace every REPLACE_ value (keys from your secret store).
# The vector-space identity is fail-closed: once a collection holds vectors from one embedding model,
# memcore refuses to start with another (use new collection names, or memcore-maintenance to erase).

MEMCORE_REQUIRE_QUALITY_TIER=compatible-unvalidated
# One chat call per start that must return valid JSON (costs one call on a paid endpoint).
MEMCORE_LLM_STARTUP_PROBE=true

MEMCORE_ENV=production
MEMCORE_HOST=0.0.0.0
MEMCORE_PORT=8080
MEMCORE_LOG_FORMAT=json
MEMCORE_LOG_LEVEL=info
MEMCORE_SECURITY_HEADERS_ENABLED=true
MEMCORE_CORS_ENABLED=false
MEMCORE_STARTUP_DEPENDENCY_TIMEOUT_SECONDS=120
MEMCORE_AUTH_ENABLED=true
MEMCORE_AUTH_MODE=dev
MEMCORE_DEV_API_KEY=REPLACE_with_a_long_random_api_key

# --- Storage (embedded SQLite shown; PostgreSQL as in profiles/reference.env.example) ---------------
MEMCORE_STORAGE_MODE=embedded
MEMCORE_FACT_BACKEND=sqlite
MEMCORE_EVENT_BACKEND=sqlite
MEMCORE_DATABASE_URL=sqlite:///app/data/memcore.db?mode=rwc
MEMCORE_DATABASE_MIGRATION_MODE=auto
MEMCORE_VECTOR_BACKEND=qdrant
MEMCORE_QDRANT_URL=http://qdrant:6334
MEMCORE_QDRANT_COLLECTION=memcore_byom_facts
MEMCORE_QDRANT_EPISODE_COLLECTION=memcore_byom_episodes

# --- Extraction / chat endpoint -------------------------------------------------------------------
MEMCORE_LLM_PROVIDER=openai
MEMCORE_LLM_MODEL=REPLACE_chat_model_id
MEMCORE_LLM_BASE_URL=https://llm.example.com/v1
MEMCORE_LLM_API_KEY=REPLACE_llm_api_key
# json_object (default; response_format json_object), json_schema (structured outputs) or
# instruction (no response_format; the prompt demands JSON) for servers that reject response_format.
MEMCORE_LLM_JSON_MODE=json_object

# --- Embedding endpoint (identity: model, revision, dimensions, prefixes, normalisation) -------------
MEMCORE_EMBEDDING_PROVIDER=openai
MEMCORE_EMBEDDING_MODEL=REPLACE_embedding_model_id
MEMCORE_EMBEDDING_BASE_URL=https://embeddings.example.com/v1
MEMCORE_EMBEDDING_API_KEY=REPLACE_embedding_api_key
MEMCORE_EMBEDDING_DIMENSIONS=1024
MEMCORE_EMBEDDING_SEND_DIMENSIONS=true
MEMCORE_EMBEDDING_NORMALIZE=false
# MEMCORE_EMBEDDING_MODEL_REVISION=
# MEMCORE_EMBEDDING_QUERY_PREFIX=
# MEMCORE_EMBEDDING_DOCUMENT_PREFIX=
# Dedup: exact text only for an uncalibrated model (D-L3). Set MEMCORE_EMBEDDING_DEDUP_THRESHOLD only
# after calibrating it for this model.
MEMCORE_PROVIDER_PROBE=true
MEMCORE_ALLOW_MOCK=false
MEMCORE_REAL_PROVIDER_CALLS_ENABLED=true
MEMCORE_PROVIDER_TEST_MODE=production
MEMCORE_PROVIDER_MAX_CALLS_PER_RUN=10000000
MEMCORE_PROVIDER_TIMEOUT_SECONDS=90

# --- Default retrieval settings, every optional feature OFF -----------------------------------------
MEMCORE_STRUCTURED_EXTRACTION_ENABLED=true
MEMCORE_STRUCTURED_EXTRACTION_POLICY=retentive
MEMCORE_EPISODES_ENABLED=true
MEMCORE_SEARCH_MAX_LIMIT=100
MEMCORE_QUERY_EMBEDDING_CACHE_CAPACITY=10000
MEMCORE_CONSOLIDATION_MODE=legacy
MEMCORE_ENTITIES_ENABLED=false
MEMCORE_QUERY_ANALYSIS_ENABLED=false
MEMCORE_TEMPORAL_RANKING_ENABLED=false
MEMCORE_MULTI_QUERY=none
MEMCORE_RERANK_PROVIDER=none
MEMCORE_QUERY_DECOMPOSITION=none
MEMCORE_EXPERIMENTAL_CANDIDATES_ENABLED=false
MEMCORE_CONTEXT_CACHE_ENABLED=false
MEMCORE_CONTEXT_CACHE_BACKEND=disabled

# --- Load protection and metrics -------------------------------------------------------------------
MEMCORE_ADMISSION_CONTROL=on
MEMCORE_PROVIDER_CHAT_MAX_CONCURRENCY=8
MEMCORE_PROVIDER_EMBEDDING_MAX_CONCURRENCY=16
MEMCORE_RATE_LIMIT_ENABLED=true
MEMCORE_RATE_LIMIT_REQUESTS_PER_MINUTE=600
MEMCORE_METRICS_ENABLED=true
MEMCORE_BACKGROUND_JOBS_ENABLED=false
