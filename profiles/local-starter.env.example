# Profile: fully local starter. Quality tier: compatible-unvalidated.
#
# No AWS, no API keys, no paid calls: Ollama (qwen2.5:3b-instruct) for extraction and TEI serving
# BAAI/bge-small-en-v1.5 for embeddings, both local (docker/docker-compose.local-starter.yml, which sets
# exactly these values). See docs/providers.md.
#
# Limitations: on a laptop CPU one ingest request takes about a minute or more; the 3B model often needs
# its classification corrected, some stored facts are fragments or assistant remarks, and UPDATE / DELETE
# decisions are unvalidated. Valid JSON output is not factual correctness.

MEMQUIRA_REQUIRE_QUALITY_TIER=compatible-unvalidated

MEMQUIRA_ENV=development
MEMQUIRA_HOST=0.0.0.0
MEMQUIRA_PORT=8080
MEMQUIRA_LOG_FORMAT=json
MEMQUIRA_LOG_LEVEL=info
MEMQUIRA_STORAGE_MODE=embedded
MEMQUIRA_FACT_BACKEND=sqlite
MEMQUIRA_EVENT_BACKEND=sqlite
MEMQUIRA_DATABASE_URL=sqlite:///app/data/memcore.db?mode=rwc
MEMQUIRA_DATABASE_MIGRATION_MODE=auto
MEMQUIRA_VECTOR_BACKEND=qdrant
MEMQUIRA_QDRANT_URL=http://qdrant:6334
MEMQUIRA_QDRANT_COLLECTION=memcore_facts
MEMQUIRA_QDRANT_EPISODE_COLLECTION=memcore_episodes
MEMQUIRA_EPISODES_ENABLED=true
MEMQUIRA_STARTUP_DEPENDENCY_TIMEOUT_SECONDS=120
MEMQUIRA_AUTH_ENABLED=true
MEMQUIRA_AUTH_MODE=dev
# Change it (docker/.env: MEMQUIRA_DEV_API_KEY=...).
MEMQUIRA_DEV_API_KEY=memcore_local_starter_key
MEMQUIRA_ALLOW_MOCK=false

# Extraction: Ollama, the shorter legacy prompt and schema-constrained output (the structured prompt
# and json_object failed with small local models).
MEMQUIRA_LLM_PROVIDER=openai
MEMQUIRA_LLM_MODEL=qwen2.5:3b-instruct
MEMQUIRA_LLM_BASE_URL=http://ollama:11434/v1
MEMQUIRA_LLM_ALLOW_NO_API_KEY=true
MEMQUIRA_STRUCTURED_EXTRACTION_ENABLED=false
MEMQUIRA_LLM_JSON_MODE=json_schema

# Embeddings: TEI, BGE-small at a pinned revision (exact-duplicate-only dedup: uncalibrated model).
# The query prefix is quoted: its trailing space is part of the embedding identity.
MEMQUIRA_EMBEDDING_PROVIDER=openai
MEMQUIRA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MEMQUIRA_EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
MEMQUIRA_EMBEDDING_SERVING_VARIANT=tei-cpu-1.7.4-onnx-cls
MEMQUIRA_EMBEDDING_BASE_URL=http://tei:80/v1
MEMQUIRA_EMBEDDING_ALLOW_NO_API_KEY=true
MEMQUIRA_EMBEDDING_DIMENSIONS=384
MEMQUIRA_EMBEDDING_SEND_DIMENSIONS=false
MEMQUIRA_EMBEDDING_NORMALIZE=true
MEMQUIRA_EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

MEMQUIRA_REAL_PROVIDER_CALLS_ENABLED=true
MEMQUIRA_PROVIDER_TEST_MODE=production
MEMQUIRA_PROVIDER_MAX_CALLS_PER_RUN=1000000
MEMQUIRA_PROVIDER_TIMEOUT_SECONDS=300
MEMQUIRA_PROVIDER_CHAT_MAX_CONCURRENCY=1
MEMQUIRA_PROVIDER_EMBEDDING_MAX_CONCURRENCY=4
MEMQUIRA_PROVIDER_PERMIT_TIMEOUT_MS=600000
MEMQUIRA_ADMISSION_WRITE_MAX_IN_FLIGHT=2
MEMQUIRA_ADMISSION_WRITE_DEADLINE_MS=900000
MEMQUIRA_PROVIDER_PROBE=true

MEMQUIRA_SEARCH_MAX_LIMIT=100
MEMQUIRA_QUERY_EMBEDDING_CACHE_CAPACITY=10000
MEMQUIRA_CONSOLIDATION_MODE=legacy
MEMQUIRA_ENTITIES_ENABLED=false
MEMQUIRA_QUERY_ANALYSIS_ENABLED=false
MEMQUIRA_TEMPORAL_RANKING_ENABLED=false
MEMQUIRA_MULTI_QUERY=none
MEMQUIRA_RERANK_PROVIDER=none
MEMQUIRA_QUERY_DECOMPOSITION=none
MEMQUIRA_EXPERIMENTAL_CANDIDATES_ENABLED=false
MEMQUIRA_CONTEXT_CACHE_ENABLED=false
MEMQUIRA_CONTEXT_CACHE_BACKEND=disabled

MEMQUIRA_RATE_LIMIT_ENABLED=true
MEMQUIRA_RATE_LIMIT_REQUESTS_PER_MINUTE=600
MEMQUIRA_METRICS_ENABLED=true
MEMQUIRA_CORS_ENABLED=false
