# Profile: fully local starter. Quality tier: compatible-unvalidated.
#
# No AWS, no API keys, no paid calls: Ollama (qwen2.5:3b-instruct) for extraction and TEI serving
# BAAI/bge-small-en-v1.5 for embeddings, both local (docker/docker-compose.local-starter.yml, which sets
# exactly these values). See docs/providers.md.
#
# Limitations: on a laptop CPU one ingest request takes about a minute or more; the 3B model often needs
# its classification corrected, some stored facts are fragments or assistant remarks, and UPDATE / DELETE
# decisions are unvalidated. Valid JSON output is not factual correctness.

MEMCORE_REQUIRE_QUALITY_TIER=compatible-unvalidated

MEMCORE_ENV=development
MEMCORE_HOST=0.0.0.0
MEMCORE_PORT=8080
MEMCORE_LOG_FORMAT=json
MEMCORE_LOG_LEVEL=info
MEMCORE_STORAGE_MODE=embedded
MEMCORE_FACT_BACKEND=sqlite
MEMCORE_EVENT_BACKEND=sqlite
MEMCORE_DATABASE_URL=sqlite:///app/data/memcore.db?mode=rwc
MEMCORE_DATABASE_MIGRATION_MODE=auto
MEMCORE_VECTOR_BACKEND=qdrant
MEMCORE_QDRANT_URL=http://qdrant:6334
MEMCORE_QDRANT_COLLECTION=memcore_facts
MEMCORE_QDRANT_EPISODE_COLLECTION=memcore_episodes
MEMCORE_EPISODES_ENABLED=true
MEMCORE_STARTUP_DEPENDENCY_TIMEOUT_SECONDS=120
MEMCORE_AUTH_ENABLED=true
MEMCORE_AUTH_MODE=dev
# Change it (docker/.env: MEMCORE_DEV_API_KEY=...).
MEMCORE_DEV_API_KEY=memcore_local_starter_key
MEMCORE_ALLOW_MOCK=false

# Extraction: Ollama, the shorter legacy prompt and schema-constrained output (the structured prompt
# and json_object failed with small local models).
MEMCORE_LLM_PROVIDER=openai
MEMCORE_LLM_MODEL=qwen2.5:3b-instruct
MEMCORE_LLM_BASE_URL=http://ollama:11434/v1
MEMCORE_LLM_ALLOW_NO_API_KEY=true
MEMCORE_STRUCTURED_EXTRACTION_ENABLED=false
MEMCORE_LLM_JSON_MODE=json_schema

# Embeddings: TEI, BGE-small at a pinned revision (exact-duplicate-only dedup: uncalibrated model).
# The query prefix is quoted: its trailing space is part of the embedding identity.
MEMCORE_EMBEDDING_PROVIDER=openai
MEMCORE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MEMCORE_EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
MEMCORE_EMBEDDING_SERVING_VARIANT=tei-cpu-1.7.4-onnx-cls
MEMCORE_EMBEDDING_BASE_URL=http://tei:80/v1
MEMCORE_EMBEDDING_ALLOW_NO_API_KEY=true
MEMCORE_EMBEDDING_DIMENSIONS=384
MEMCORE_EMBEDDING_SEND_DIMENSIONS=false
MEMCORE_EMBEDDING_NORMALIZE=true
MEMCORE_EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

MEMCORE_REAL_PROVIDER_CALLS_ENABLED=true
MEMCORE_PROVIDER_TEST_MODE=production
MEMCORE_PROVIDER_MAX_CALLS_PER_RUN=1000000
MEMCORE_PROVIDER_TIMEOUT_SECONDS=300
MEMCORE_PROVIDER_CHAT_MAX_CONCURRENCY=1
MEMCORE_PROVIDER_EMBEDDING_MAX_CONCURRENCY=4
MEMCORE_PROVIDER_PERMIT_TIMEOUT_MS=600000
MEMCORE_ADMISSION_WRITE_MAX_IN_FLIGHT=2
MEMCORE_ADMISSION_WRITE_DEADLINE_MS=900000
MEMCORE_PROVIDER_PROBE=true

MEMCORE_SEARCH_MAX_LIMIT=100
MEMCORE_QUERY_EMBEDDING_CACHE_CAPACITY=10000
MEMCORE_CONSOLIDATION_MODE=legacy
MEMCORE_ENTITIES_ENABLED=false
MEMCORE_QUERY_ANALYSIS_ENABLED=false
MEMCORE_TEMPORAL_RANKING_ENABLED=false
MEMCORE_MULTI_QUERY=none
MEMCORE_RERANK_PROVIDER=none
MEMCORE_QUERY_DECOMPOSITION=none
MEMCORE_EXPERIMENTAL_CANDIDATES_ENABLED=false
MEMCORE_CONTEXT_CACHE_ENABLED=false
MEMCORE_CONTEXT_CACHE_BACKEND=disabled

MEMCORE_RATE_LIMIT_ENABLED=true
MEMCORE_RATE_LIMIT_REQUESTS_PER_MINUTE=600
MEMCORE_METRICS_ENABLED=true
MEMCORE_CORS_ENABLED=false
