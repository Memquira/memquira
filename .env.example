# memquira environment template (generic / shared reference)
#
# Prefer environment-specific files:
#   .env.local.example      → local quickstart
#   .env.staging.example    → staging-shaped stack
#   .env.production.example → production-shaped stack
#
# Copy to `.env` (never commit real secrets). See docs/configuration.md.
# Placeholders only — replace CHANGE_ME values before any real deployment.

# =============================================================================
# Server
# =============================================================================
MEMQUIRA_ENV=development
MEMQUIRA_HOST=0.0.0.0
MEMQUIRA_PORT=8080

# =============================================================================
# Auth
# =============================================================================
MEMQUIRA_AUTH_ENABLED=true
# dev = plaintext MEMQUIRA_DEV_API_KEY; database = hashed keys + pepper
MEMQUIRA_AUTH_MODE=dev
MEMQUIRA_DEV_API_KEY=CHANGE_ME_DEV_API_KEY
# Required when MEMQUIRA_AUTH_MODE=database
MEMQUIRA_API_KEY_PEPPER=CHANGE_ME_API_KEY_PEPPER

# =============================================================================
# Storage / database
# =============================================================================
MEMQUIRA_STORAGE_MODE=embedded
MEMQUIRA_FACT_BACKEND=sqlite
MEMQUIRA_EVENT_BACKEND=sqlite
# `mode=rwc` creates the database file on first start; the `data/` directory must exist.
MEMQUIRA_DATABASE_URL=sqlite://./data/memcore.db?mode=rwc
# Required when fact/event backend is postgres:
# MEMQUIRA_POSTGRES_URL=postgres://memcore:CHANGE_ME@localhost:5432/memcore

MEMQUIRA_DATABASE_MIGRATIONS_ENABLED=true
MEMQUIRA_DATABASE_MIGRATION_MODE=auto
MEMQUIRA_DATABASE_REQUIRE_CLEAN_MIGRATIONS=true

# =============================================================================
# Vector store
# =============================================================================
# Explicit mock avoids defaulting to Qdrant when unset .
MEMQUIRA_VECTOR_BACKEND=mock
MEMQUIRA_QDRANT_URL=http://localhost:6334
# MEMQUIRA_QDRANT_URL=http://localhost:6333  # REST only — Rust client needs gRPC :6334
# MEMQUIRA_QDRANT_COLLECTION=memcore_vectors

# =============================================================================
# LLM / embedding providers
# =============================================================================
MEMQUIRA_LLM_PROVIDER=mock
MEMQUIRA_LLM_MODEL=mock-llm
MEMQUIRA_EMBEDDING_PROVIDER=mock
MEMQUIRA_EMBEDDING_MODEL=mock-embedding
# The server refuses to start on mock providers unless this is true. Mock providers return fake
# extractions and embeddings: tests and local development only, never production.
MEMQUIRA_ALLOW_MOCK=true
# How long startup waits for Qdrant / Postgres to become reachable (0 = one attempt).
MEMQUIRA_STARTUP_DEPENDENCY_TIMEOUT_SECONDS=60
# OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
# OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
# Context cache
# =============================================================================
# Context cache: only `disabled` is supported here. Startup refuses
# `redis` (shared-cache invalidation across API processes is not verified) and refuses `memory`
# outside local single-process development (docs/configuration.md).
MEMQUIRA_CONTEXT_CACHE_BACKEND=disabled
# MEMQUIRA_CONTEXT_CACHE_TTL_SECONDS=300
# MEMQUIRA_CONTEXT_CACHE_MAX_ENTRIES=1000
# MEMQUIRA_CONTEXT_CACHE_KEY_PREFIX=memquira

# =============================================================================
# Background jobs
# =============================================================================
MEMQUIRA_BACKGROUND_JOBS_ENABLED=false
MEMQUIRA_BACKGROUND_JOB_RUNNER_INTERVAL_SECONDS=60
# MEMQUIRA_BACKGROUND_JOB_ORG_IDS=
MEMQUIRA_BACKGROUND_JOB_LOCK_ENABLED=false
MEMQUIRA_BACKGROUND_JOB_RETRIES_ENABLED=true
MEMQUIRA_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30
MEMQUIRA_BACKGROUND_JOB_SHUTDOWN_TIMEOUT_SECONDS=30

# =============================================================================
# Rate limits / quotas / retention
# =============================================================================
MEMQUIRA_RATE_LIMIT_ENABLED=true
MEMQUIRA_RATE_LIMIT_REQUESTS_PER_MINUTE=60
MEMQUIRA_QUOTAS_ENABLED=false
MEMQUIRA_RETENTION_ENABLED=false
MEMQUIRA_ENABLE_PII_REDACTION=true
MEMQUIRA_MIN_IMPORTANCE=0.55

# =============================================================================
# Security / CORS
# =============================================================================
MEMQUIRA_SECURITY_HEADERS_ENABLED=true
MEMQUIRA_MAX_REQUEST_BODY_BYTES=1048576
MEMQUIRA_CORS_ENABLED=false
# MEMQUIRA_CORS_ALLOWED_ORIGINS=
MEMQUIRA_CORS_ALLOW_CREDENTIALS=false

# =============================================================================
# Backup
# =============================================================================
MEMQUIRA_BACKUP_ENABLED=false
MEMQUIRA_BACKUP_DIR=./backups
MEMQUIRA_BACKUP_MAX_FILES=10
MEMQUIRA_RESTORE_ENABLED=false

# =============================================================================
# Observability
# =============================================================================
MEMQUIRA_LOG_FORMAT=pretty
MEMQUIRA_LOG_LEVEL=info
MEMQUIRA_REQUEST_ID_HEADER=X-Request-ID
MEMQUIRA_METRICS_ENABLED=false
MEMQUIRA_METRICS_PATH=/metrics
MEMQUIRA_METRICS_REQUIRE_AUTH=true
MEMQUIRA_METRICS_INCLUDE_PROCESS=false

# =============================================================================
# Release metadata (build-time; optional at runtime)
# =============================================================================
# MEMQUIRA_BUILD_GIT_SHA=unknown
# MEMQUIRA_BUILD_TIMESTAMP=unknown
# MEMQUIRA_BUILD_PROFILE=release

# =============================================================================
# Docker Compose Postgres bootstrap only (not read by memquira Settings)
# =============================================================================
# POSTGRES_DB=memcore
# POSTGRES_USER=memcore
# POSTGRES_PASSWORD=CHANGE_ME
