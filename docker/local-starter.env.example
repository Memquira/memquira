# Fully local starter overrides. Copy to docker/.env (Compose reads it automatically
# from the compose file's directory) and edit. No secrets are needed: the stack calls only local
# Ollama / TEI containers. Never commit docker/.env.

# The API key clients send as `Authorization: Bearer <key>`. CHANGE THIS.
MEMCORE_DEV_API_KEY=memcore_local_starter_key

# Host ports (bound to 127.0.0.1 only).
MEMCORE_HOST_PORT=8080
STARTER_QDRANT_HOST_PORT=6333

# Extraction model served by Ollama (pulled on first `up`). Tested: qwen2.5:3b-instruct.
# Any other model is unvalidated (see docs/providers.md).
STARTER_LLM_MODEL=qwen2.5:3b-instruct

# Only with docker-compose.local-starter.ollama-embed.yml (TEI-less fallback). Changing the
# embedding model requires fresh volumes: memcore refuses stores written with another identity.
STARTER_OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
