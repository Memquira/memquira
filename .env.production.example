# Memquira production environment for docker/docker-compose.prod.yml.
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# Replace every CHANGE_ME value (generate secrets with `openssl rand -hex 32`) and keep the file out of git.
# Pass it both as --env-file (Compose interpolation) and, by default, as the API container's env_file.
# The `MEMQUIRA_` prefix is the engine's configuration namespace. Full reference: docs/configuration.md.

# --- Secrets -----------------------------------------------------------------------------------------
# PostgreSQL password; Compose builds MEMQUIRA_POSTGRES_URL from it. Use only URL-safe characters
# (hex is safest).
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# HMAC pepper for API key hashes. Changing it later invalidates every API key.
MEMQUIRA_API_KEY_PEPPER=CHANGE_ME_LONG_RANDOM_PEPPER

# --- Runtime -----------------------------------------------------------------------------------------
MEMQUIRA_ENV=production
MEMQUIRA_LOG_FORMAT=json
MEMQUIRA_LOG_LEVEL=info
MEMQUIRA_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30
MEMQUIRA_STARTUP_DEPENDENCY_TIMEOUT_SECONDS=60
MEMQUIRA_DATABASE_MIGRATIONS_ENABLED=true
MEMQUIRA_DATABASE_MIGRATION_MODE=auto
MEMQUIRA_DATABASE_REQUIRE_CLEAN_MIGRATIONS=true
MEMQUIRA_QDRANT_COLLECTION=memcore_vectors
MEMQUIRA_QDRANT_EPISODE_COLLECTION=memcore_vectors_episodes

# --- Authentication ----------------------------------------------------------------------------------
# Database mode: hashed, scoped, organization-bound API keys. Create the first admin key with
# scripts/ops/bootstrap_admin_key.sh, then mint scoped application keys through POST /api/v1/api-keys.
MEMQUIRA_AUTH_ENABLED=true
MEMQUIRA_AUTH_MODE=database

# --- Providers (OpenAI; any OpenAI-compatible endpoint works, see docs/providers.md) -----------------
MEMQUIRA_LLM_PROVIDER=openai
MEMQUIRA_LLM_MODEL=gpt-4o-mini
MEMQUIRA_LLM_BASE_URL=https://api.openai.com/v1
MEMQUIRA_LLM_API_KEY=CHANGE_ME_OPENAI_API_KEY
MEMQUIRA_LLM_JSON_MODE=json_object
MEMQUIRA_EMBEDDING_PROVIDER=openai
MEMQUIRA_EMBEDDING_MODEL=text-embedding-3-small
MEMQUIRA_EMBEDDING_BASE_URL=https://api.openai.com/v1
MEMQUIRA_EMBEDDING_API_KEY=CHANGE_ME_OPENAI_API_KEY
MEMQUIRA_EMBEDDING_DIMENSIONS=1536
MEMQUIRA_ALLOW_MOCK=false
MEMQUIRA_REAL_PROVIDER_CALLS_ENABLED=true
MEMQUIRA_PROVIDER_TEST_MODE=production
# Each start makes one small embedding call (identity check), billed by your provider. Set
# MEMQUIRA_LLM_STARTUP_PROBE=true to also verify the chat model with one call per start.
MEMQUIRA_PROVIDER_PROBE=true
MEMQUIRA_LLM_STARTUP_PROBE=false
MEMQUIRA_PROVIDER_TIMEOUT_SECONDS=90
MEMQUIRA_PROVIDER_MAX_RETRIES=2
MEMQUIRA_PROVIDER_CIRCUIT_BREAKER_ENABLED=true
# Provider guardrails. The per-process call counter defaults to 10, a safety default for tests: a real
# deployment must raise it, or every provider call after the first 10 is refused until the next restart.
# It is not a spending control; cap spend with your provider's project limits.
MEMQUIRA_PROVIDER_MAX_CALLS_PER_RUN=1000000
# Largest input of one provider call (extraction window, or a candidate plus related facts).
MEMQUIRA_PROVIDER_MAX_INPUT_CHARS=7000
MEMQUIRA_PROVIDER_CHAT_MAX_CONCURRENCY=8
MEMQUIRA_PROVIDER_EMBEDDING_MAX_CONCURRENCY=16
# A non-reference provider runs in the `compatible-unvalidated` quality tier; startup requires the tier
# to be accepted explicitly.
MEMQUIRA_REQUIRE_QUALITY_TIER=compatible-unvalidated

# --- Retrieval ---------------------------------------------------------------------------------------
# A search limit of at least 100 is required by POST /api/v1/memories/context. Episodes (source-message
# memory) add source messages to the context and enable message-id deduplication and conflict detection.
MEMQUIRA_EPISODES_ENABLED=true
MEMQUIRA_SEARCH_MAX_LIMIT=100
MEMQUIRA_SEARCH_STRATEGY=hybrid
MEMQUIRA_QDRANT_SEARCH_HNSW_EF=256
MEMQUIRA_CONTEXT_DEFAULT_PACKING=prefix
MEMQUIRA_STRUCTURED_EXTRACTION_ENABLED=true
MEMQUIRA_STRUCTURED_EXTRACTION_POLICY=retentive
MEMQUIRA_CONSOLIDATION_MODE=legacy

# --- Protection --------------------------------------------------------------------------------------
# Per-organization, per-process request limit (429 RATE_LIMITED beyond it).
MEMQUIRA_RATE_LIMIT_ENABLED=true
MEMQUIRA_RATE_LIMIT_REQUESTS_PER_MINUTE=120
# Concurrency admission (503 OVERLOADED with Retry-After beyond in-flight + queue).
MEMQUIRA_ADMISSION_CONTROL=on
MEMQUIRA_ADMISSION_READ_MAX_IN_FLIGHT=16
MEMQUIRA_ADMISSION_WRITE_MAX_IN_FLIGHT=4
MEMQUIRA_MAX_REQUEST_BODY_BYTES=1048576
# Per-organization quotas (0 = unlimited).
MEMQUIRA_QUOTAS_ENABLED=true
MEMQUIRA_MAX_MEMORIES_PER_USER=500
MEMQUIRA_MAX_USERS_PER_ORG=1000
# Persist provider token usage per call (GET /api/v1/admin/org/provider-usage).
MEMQUIRA_PROVIDER_USAGE_PERSISTENCE_ENABLED=true
MEMQUIRA_SECURITY_HEADERS_ENABLED=true
# Browsers should not call the API directly; keep CORS off and call it from your backend.
MEMQUIRA_CORS_ENABLED=false
MEMQUIRA_ENABLE_PII_REDACTION=true
# The context cache must stay disabled in production (startup refuses the other backends here).
MEMQUIRA_CONTEXT_CACHE_BACKEND=disabled

# --- Metrics -----------------------------------------------------------------------------------------
MEMQUIRA_METRICS_ENABLED=true
MEMQUIRA_METRICS_REQUIRE_AUTH=true

# --- Resource limits (Compose) -----------------------------------------------------------------------
MEMQUIRA_BIND_PORT=8080
MEMQUIRA_MEMQUIRA_MEM_LIMIT=1g
MEMQUIRA_MEMQUIRA_CPUS=1.0
MEMQUIRA_POSTGRES_MEM_LIMIT=1g
MEMQUIRA_POSTGRES_CPUS=1.0
MEMQUIRA_QDRANT_MEM_LIMIT=1g
MEMQUIRA_QDRANT_CPUS=1.0
