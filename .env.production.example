# Memquira production environment for docker/docker-compose.prod.yml.
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# Replace every CHANGE_ME value (generate secrets with `openssl rand -hex 32`) and keep the file out of git.
# Pass it both as --env-file (Compose interpolation) and, by default, as the API container's env_file.
# The `MEMCORE_` prefix is the engine's configuration namespace. Full reference: docs/configuration.md.

# --- Secrets -----------------------------------------------------------------------------------------
# PostgreSQL password; Compose builds MEMCORE_POSTGRES_URL from it. Use only URL-safe characters
# (hex is safest).
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# HMAC pepper for API key hashes. Changing it later invalidates every API key.
MEMCORE_API_KEY_PEPPER=CHANGE_ME_LONG_RANDOM_PEPPER

# --- Runtime -----------------------------------------------------------------------------------------
MEMCORE_ENV=production
MEMCORE_LOG_FORMAT=json
MEMCORE_LOG_LEVEL=info
MEMCORE_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30
MEMCORE_STARTUP_DEPENDENCY_TIMEOUT_SECONDS=60
MEMCORE_DATABASE_MIGRATIONS_ENABLED=true
MEMCORE_DATABASE_MIGRATION_MODE=auto
MEMCORE_DATABASE_REQUIRE_CLEAN_MIGRATIONS=true
MEMCORE_QDRANT_COLLECTION=memcore_vectors
MEMCORE_QDRANT_EPISODE_COLLECTION=memcore_vectors_episodes

# --- Authentication ----------------------------------------------------------------------------------
# Database mode: hashed, scoped, organization-bound API keys. Create the first admin key with
# scripts/ops/bootstrap_admin_key.sh, then mint scoped application keys through POST /api/v1/api-keys.
MEMCORE_AUTH_ENABLED=true
MEMCORE_AUTH_MODE=database

# --- Providers (OpenAI; any OpenAI-compatible endpoint works, see docs/providers.md) -----------------
MEMCORE_LLM_PROVIDER=openai
MEMCORE_LLM_MODEL=gpt-4o-mini
MEMCORE_LLM_BASE_URL=https://api.openai.com/v1
MEMCORE_LLM_API_KEY=CHANGE_ME_OPENAI_API_KEY
MEMCORE_LLM_JSON_MODE=json_object
MEMCORE_EMBEDDING_PROVIDER=openai
MEMCORE_EMBEDDING_MODEL=text-embedding-3-small
MEMCORE_EMBEDDING_BASE_URL=https://api.openai.com/v1
MEMCORE_EMBEDDING_API_KEY=CHANGE_ME_OPENAI_API_KEY
MEMCORE_EMBEDDING_DIMENSIONS=1536
MEMCORE_ALLOW_MOCK=false
MEMCORE_REAL_PROVIDER_CALLS_ENABLED=true
MEMCORE_PROVIDER_TEST_MODE=production
# Each start makes one small embedding call (identity check), billed by your provider. Set
# MEMCORE_LLM_STARTUP_PROBE=true to also verify the chat model with one call per start.
MEMCORE_PROVIDER_PROBE=true
MEMCORE_LLM_STARTUP_PROBE=false
MEMCORE_PROVIDER_TIMEOUT_SECONDS=90
MEMCORE_PROVIDER_MAX_RETRIES=2
MEMCORE_PROVIDER_CIRCUIT_BREAKER_ENABLED=true
# Provider guardrails. The per-process call counter defaults to 10, a safety default for tests: a real
# deployment must raise it, or every provider call after the first 10 is refused until the next restart.
# It is not a spending control; cap spend with your provider's project limits.
MEMCORE_PROVIDER_MAX_CALLS_PER_RUN=1000000
# Largest input of one provider call (extraction window, or a candidate plus related facts).
MEMCORE_PROVIDER_MAX_INPUT_CHARS=7000
MEMCORE_PROVIDER_CHAT_MAX_CONCURRENCY=8
MEMCORE_PROVIDER_EMBEDDING_MAX_CONCURRENCY=16
# A non-reference provider runs in the `compatible-unvalidated` quality tier; startup requires the tier
# to be accepted explicitly.
MEMCORE_REQUIRE_QUALITY_TIER=compatible-unvalidated

# --- Retrieval ---------------------------------------------------------------------------------------
# A search limit of at least 100 is required by POST /api/v1/memories/context. Episodes (source-message
# memory) add source messages to the context and enable message-id deduplication and conflict detection.
MEMCORE_EPISODES_ENABLED=true
MEMCORE_SEARCH_MAX_LIMIT=100
MEMCORE_SEARCH_STRATEGY=hybrid
MEMCORE_QDRANT_SEARCH_HNSW_EF=256
MEMCORE_CONTEXT_DEFAULT_PACKING=prefix
MEMCORE_STRUCTURED_EXTRACTION_ENABLED=true
MEMCORE_STRUCTURED_EXTRACTION_POLICY=retentive
MEMCORE_CONSOLIDATION_MODE=legacy

# --- Protection --------------------------------------------------------------------------------------
# Per-organization, per-process request limit (429 RATE_LIMITED beyond it).
MEMCORE_RATE_LIMIT_ENABLED=true
MEMCORE_RATE_LIMIT_REQUESTS_PER_MINUTE=120
# Concurrency admission (503 OVERLOADED with Retry-After beyond in-flight + queue).
MEMCORE_ADMISSION_CONTROL=on
MEMCORE_ADMISSION_READ_MAX_IN_FLIGHT=16
MEMCORE_ADMISSION_WRITE_MAX_IN_FLIGHT=4
MEMCORE_MAX_REQUEST_BODY_BYTES=1048576
# Per-organization quotas (0 = unlimited).
MEMCORE_QUOTAS_ENABLED=true
MEMCORE_MAX_MEMORIES_PER_USER=500
MEMCORE_MAX_USERS_PER_ORG=1000
# Persist provider token usage per call (GET /api/v1/admin/org/provider-usage).
MEMCORE_PROVIDER_USAGE_PERSISTENCE_ENABLED=true
MEMCORE_SECURITY_HEADERS_ENABLED=true
# Browsers should not call the API directly; keep CORS off and call it from your backend.
MEMCORE_CORS_ENABLED=false
MEMCORE_ENABLE_PII_REDACTION=true
# The context cache must stay disabled in production (startup refuses the other backends here).
MEMCORE_CONTEXT_CACHE_BACKEND=disabled

# --- Metrics -----------------------------------------------------------------------------------------
MEMCORE_METRICS_ENABLED=true
MEMCORE_METRICS_REQUIRE_AUTH=true

# --- Resource limits (Compose) -----------------------------------------------------------------------
MEMQUIRA_BIND_PORT=8080
MEMQUIRA_MEMCORE_MEM_LIMIT=1g
MEMQUIRA_MEMCORE_CPUS=1.0
MEMQUIRA_POSTGRES_MEM_LIMIT=1g
MEMQUIRA_POSTGRES_CPUS=1.0
MEMQUIRA_QDRANT_MEM_LIMIT=1g
MEMQUIRA_QDRANT_CPUS=1.0
